# Chave usada para assinar as sessões da aplicação.
# Nunca utilize este valor literalmente em produção.
STOCKFLOW_SECRET_KEY=gere-uma-chave-secreta-diferente

# Sem esta variável, o sistema utiliza SQLite localmente.
# No deploy, substitua pelo endereço real do PostgreSQL.
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco

# Níveis disponíveis: DEBUG, INFO, WARNING, ERROR e CRITICAL.
LOG_LEVEL=INFO
